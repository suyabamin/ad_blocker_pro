{
  "name": "hush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:chrome": "node scripts/build.mjs --watch --browser=chrome",
    "dev:firefox": "node scripts/build.mjs --watch --browser=firefox",
    "build:chrome": "node scripts/build.mjs --browser=chrome",
    "build:firefox": "node scripts/build.mjs --browser=firefox",
    "update-lists": "node scripts/update-lists.mjs",
    "build-rulesets": "node scripts/build-rulesets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src/ scripts/ tests/",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@adguard/tsurlfilter": "6.0.4",
    "@types/chrome": "0.0.280",
    "@types/node": "22.8.7",
    "@types/webextension-polyfill": "0.12.1",
    "esbuild": "0.24.0",
    "eslint": "9.14.0",
    "jsdom": "25.0.1",
    "playwright": "1.48.2",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vitest": "2.1.4",
    "web-ext": "8.3.0"
  }
}
